{
  "name": "bing-webmaster-mcp",
  "version": "0.1.3",
  "description": "Bing Webmaster Tools and IndexNow API MCP server for AI agents: search performance, crawl issues, and instant URL indexing.",
  "author": {
    "name": "Surendran B",
    "url": "https://github.com/surendranb"
  },
  "homepage": "https://bing-webmaster.builditwithai.xyz",
  "repository": "https://github.com/surendranb/bing-webmaster-mcp-server",
  "license": "MIT",
  "mcpServers": {
    "bing-webmaster-mcp": {
      "command": "uvx",
      "args": [
        "bing-webmaster-mcp==0.1.3"
      ],
      "env": {
        "BING_WEBMASTER_API_KEY": "${input:BING_WEBMASTER_API_KEY}",
        "INDEXNOW_KEY": "${input:INDEXNOW_KEY}"
      }
    }
  }
}
